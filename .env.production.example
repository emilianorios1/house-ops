# Copy this file to ~/.config/home-lab/prod.env and chmod it to 600.
# scripts/install-production.sh creates a secure version automatically.
POSTGRES_DB=home_lab_prod
POSTGRES_USER=home_lab_prod
POSTGRES_PASSWORD=replace-with-a-long-random-password
HOME_LAB_IMAGE=ghcr.io/emilianorios1/house-ops:example-only

# Keep the diagnostic port private when Caddy is the public entry point.
HOME_LAB_PROD_BIND=127.0.0.1
HOME_LAB_PROD_PORT=8501
HOME_LAB_PROD_DATA_DIR=/home/your-user/.local/share/home-lab/production
HOME_LAB_PROD_SECRETS_DIR=/home/your-user/.config/home-lab/secrets
HOME_LAB_BACKUP_DIR=/home/your-user/.local/share/home-lab/backups
HOME_LAB_BACKUP_RETENTION_DAYS=14
HOME_LAB_HOST_UID=1000
HOME_LAB_HOST_GID=1000
HOUSE_OPS_SECRET_KEY=replace-with-a-long-random-secret
HOUSE_OPS_DEBUG=false
HOUSE_OPS_ALLOWED_HOSTS=casa.bordarteuniformes.com.ar
HOUSE_OPS_HTTPS=true
HOUSE_OPS_ADMIN_USERNAME=emiliano
HOUSE_OPS_ADMIN_PASSWORD=replace-with-a-private-password
HOUSE_OPS_SECOND_USERNAME=vitoria
HOUSE_OPS_SECOND_PASSWORD=replace-with-a-private-password

# Next.js accepts AUTH_SECRET or the existing HOUSE_OPS_SECRET_KEY.
# Do not overwrite the installed prod.env or change existing credentials.
